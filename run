#!/usr/bin/env bash
#
# One entry point for every way of running this project.
# `./run` with no arguments lists the scenarios.
#
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

# `.env` is the local counterpart of what compose already substitutes for the Docker stack.
# Read line by line rather than sourced, so the conventional precedence holds: command line,
# then the file, then the defaults below. `. ./.env` assigns unconditionally and would let the
# file override an explicit `PORT=4100 ./run dev`.
#
# The grammar is plain `KEY=value`, matching what compose itself reads: no quoting, no
# expansion, `#` starts a comment.
load_env_file() {
  [ -f .env ] || return 0
  local line key
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in '' | \#*) continue ;; esac
    key=${line%%=*}
    [ -n "${!key:-}" ] && continue
    export "$key=${line#*=}"
  done < .env
}

load_env_file

APP_PORT="${PORT:-4000}"
WEB_PORT="${WEB_PORT:-5173}"
DB_HOST_PORT=5434
RUN_STATE=".run"
COMPOSE_DB_URL="postgres://postgres:postgres@localhost:${DB_HOST_PORT}/cabins"

# ── output ───────────────────────────────────────────────────────────────────

if [ -t 1 ]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; OFF=$'\033[0m'
else
  BOLD=''; DIM=''; RED=''; GREEN=''; YELLOW=''; OFF=''
fi

step() { printf '%s→ %s%s\n' "$BOLD" "$1" "$OFF"; }
ok()   { printf '%s✓ %s%s\n' "$GREEN" "$1" "$OFF"; }
note() { printf '%s  %s%s\n' "$DIM" "$1" "$OFF"; }

# Fail with an instruction, not just a symptom.
die() {
  printf '%s✗ %s%s\n' "$RED" "$1" "$OFF" >&2
  [ $# -gt 1 ] && printf '%s  %s%s\n' "$YELLOW" "$2" "$OFF" >&2
  exit 1
}

# ── preflight ────────────────────────────────────────────────────────────────

need_docker() {
  command -v docker >/dev/null 2>&1 ||
    die "Docker is not installed." "Install Docker Desktop, then run this again."
  docker info >/dev/null 2>&1 ||
    die "Docker is installed but not running." "Start Docker Desktop and wait for it to report ready."
}

need_node() {
  command -v node >/dev/null 2>&1 || die "Node is not installed." "Install Node 24 or newer."
  local major
  major="$(node -p 'process.versions.node.split(".")[0]')"
  if [ "$major" -lt 24 ]; then
    printf '%s! Node %s is older than the required 24.%s\n' "$YELLOW" "$(node -v)" "$OFF" >&2
    note "nvm use   (or install Node 24) — continuing anyway"
  fi
}

need_deps() {
  [ -d node_modules ] || { step "Installing dependencies"; npm install; }
}

need_env() {
  if [ ! -f .env ]; then
    step "Creating .env from .env.example"
    cp .env.example .env
    note "DATABASE_URL already points at the compose database on port ${DB_HOST_PORT}"
    note "ENGINE_API_KEY is empty — see the README for how to issue one"
  fi
}

# The engine is not optional. Without it the calendar cannot say which nights are free, and
# "connection refused" in a browser console is a worse first experience than a sentence
# naming the cause and the fix.
need_engine() {
  local url="${ENGINE_URL:-http://localhost:3000}"
  if ! curl -fsS --max-time 3 "${url}/health" </dev/null >/dev/null 2>&1; then
    die "The booking engine is not answering on ${url}." \
      "Start it first:  (cd ../booking-engine && ./run dev --bg)"
  fi
  [ -n "${ENGINE_API_KEY:-}" ] ||
    die "ENGINE_API_KEY is empty in .env." \
      "Issue a 'Site backend' key in the engine's console and paste it in — see the README."
}

# A Secure cookie is not stored by a browser that received it over plain http, and the failure
# is silent: the owner signs in, appears to succeed, and is signed out on the very next tap.
# That reads as a broken login rather than a missing certificate, which is why it is refused
# here rather than discovered on the phone.
need_plain_http_cookie() {
  [ "${NODE_ENV:-}" != "production" ] ||
    die "NODE_ENV is production, so the session cookie is set Secure." \
      "A browser will not store it over plain http. Unset NODE_ENV for a local run."
}

# Migrations create the tables and stop there. Without a password there is no way in, and the
# symptom — every password rejected — reads as a broken build rather than a step not yet taken.
need_setup() {
  local state
  state=$( cd server && DATABASE_URL="${DATABASE_URL:-$COMPOSE_DB_URL}" npx tsx scripts/setup-state.ts </dev/null ) ||
    die "Could not read the setup state from the database." "Check:  docker compose logs db"

  case "$state" in
    *owner=missing*)
      die "No owner password is set, so nobody can sign in." \
        "Set one first:  ./run owner:password"
      ;;
  esac

  # A note rather than a refusal: the Дома screen says how to add the first house, so an empty
  # install is a state the app explains for itself.
  case "$state" in
    *houses=missing*)
      note "No houses yet. The calendar stays empty until you add one:  ./run house:add"
      ;;
  esac
}

# Best effort, and never fatal. The phone is the whole reason the server binds 0.0.0.0, but
# failing to guess which address it should be reached on is no reason not to start.
lan_address() {
  local ip=''
  if command -v ipconfig >/dev/null 2>&1; then
    ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)
  fi
  if [ -z "$ip" ]; then
    ip=$(hostname -I 2>/dev/null | awk '{print $1}' || true)
  fi
  printf '%s' "$ip"
}

start_db() {
  need_docker
  step "Starting Postgres on port ${DB_HOST_PORT}"
  # Every preflight command reads stdin from /dev/null: the scenarios that prompt or accept a
  # pipe — owner:password, house:add — must be the only things consuming it.
  docker compose up -d db </dev/null >/dev/null

  local waited=0
  # stdin comes from /dev/null on purpose: `docker compose exec` attaches it even with -T, and
  # would swallow input meant for the scenario — `owner:password` reads a password from a pipe.
  until docker compose exec -T db pg_isready -U postgres -d cabins </dev/null >/dev/null 2>&1; do
    sleep 1
    waited=$((waited + 1))
    [ "$waited" -gt 60 ] && die "Postgres did not become ready within a minute." \
      "Check:  docker compose logs db"
  done
  ok "Postgres ready"
}

run_migrations() {
  step "Applying migrations"
  DATABASE_URL="${DATABASE_URL:-$COMPOSE_DB_URL}" npm run --silent --workspace server migrate
}

# ── scenarios ────────────────────────────────────────────────────────────────

scenario_dev() {
  need_node; need_deps; need_env
  start_db
  run_migrations
  need_engine

  export DATABASE_URL="${DATABASE_URL:-$COMPOSE_DB_URL}"
  export PORT="$APP_PORT"

  if [ "${1:-}" = "--bg" ]; then
    mkdir -p "$RUN_STATE"
    npm run --workspace server dev  >"$RUN_STATE/server.log" 2>&1 & echo $! >"$RUN_STATE/server.pid"
    npm run --workspace web  dev -- --port "$WEB_PORT" >"$RUN_STATE/web.log" 2>&1 & echo $! >"$RUN_STATE/web.pid"
    ok "Running in the background"
    note "http://localhost:${WEB_PORT}   logs: ${RUN_STATE}/*.log   stop: ./run stop"
    return
  fi

  ok "Server on :${APP_PORT}, app on http://localhost:${WEB_PORT}"
  note "Ctrl-C stops both"

  # Both in the foreground with labelled output, and either one dying takes the pair down —
  # a half-running stack looks like a bug in the app rather than a stopped process.
  trap 'kill 0' EXIT INT TERM
  npm run --workspace server dev 2>&1 | sed "s/^/${DIM}[server]${OFF} /" &
  npm run --workspace web dev -- --port "$WEB_PORT" 2>&1 | sed "s/^/${DIM}[web]   ${OFF} /" &
  wait
}

# The counterpart of `dev`: the built SPA served by the built server, both on one port, which
# is the shape the product actually has. `dev` puts Vite on a second port bound to localhost,
# so it is reachable from this machine and from nowhere else — and a tool the owner opens from
# a phone has to be reachable from the phone.
scenario_start() {
  need_node; need_deps; need_env
  need_plain_http_cookie
  start_db
  run_migrations
  need_engine
  need_setup
  scenario_build

  export DATABASE_URL="${DATABASE_URL:-$COMPOSE_DB_URL}"
  export PORT="$APP_PORT"

  local lan; lan=$(lan_address)

  if [ "${1:-}" = "--bg" ]; then
    mkdir -p "$RUN_STATE"
    npm run --workspace server start >"$RUN_STATE/app.log" 2>&1 & echo $! >"$RUN_STATE/app.pid"
    ok "Running in the background"
    note "http://localhost:${APP_PORT}   logs: ${RUN_STATE}/app.log   stop: ./run stop"
    if [ -n "$lan" ]; then
      note "From a phone on the same network: http://${lan}:${APP_PORT}"
    fi
    return 0
  fi

  ok "http://localhost:${APP_PORT}"
  if [ -n "$lan" ]; then
    note "From a phone on the same network: http://${lan}:${APP_PORT}"
  fi
  note "Ctrl-C stops it"
  npm run --workspace server start
}

# Everything `dev --bg` and `start --bg` leave behind, whichever of the two it was: one stop
# command that does not have to be told which way the stack was started.
scenario_stop() {
  local stopped=0
  for pidfile in "$RUN_STATE"/*.pid; do
    [ -f "$pidfile" ] || continue
    local pid; pid=$(cat "$pidfile")
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      stopped=1
    fi
    rm -f "$pidfile"
  done
  [ "$stopped" = 1 ] && ok "Stopped" || note "Nothing was running in the background"
}

scenario_test() {
  need_node; need_deps; need_docker
  step "Server suite (Testcontainers builds the engine image on a cold run)"
  npm run --workspace server test
  step "Web unit tests"
  npm run --workspace web test
}

scenario_test_ui() {
  need_node; need_deps; need_docker
  step "Browser journeys against the whole product"
  npx playwright test
}

scenario_migrate() {
  need_node; need_deps; need_env
  start_db
  run_migrations
  ok "Migrations applied"
}

scenario_password() {
  need_node; need_deps; need_env
  start_db
  run_migrations
  # Invoked directly rather than through `npm run`: this script reads a password from stdin,
  # and npm's workspace indirection does not hand a piped one through.
  ( cd server && DATABASE_URL="${DATABASE_URL:-$COMPOSE_DB_URL}" npx tsx scripts/set-password.ts )
}

scenario_house_add() {
  need_node; need_deps; need_env
  start_db
  run_migrations
  need_engine
  # Directly rather than through `npm run`: this prompts, and npm's workspace indirection
  # does not hand a piped or interactive stdin through.
  ( cd server && DATABASE_URL="${DATABASE_URL:-$COMPOSE_DB_URL}" npx tsx scripts/add-house.ts )
}

scenario_house_checkin() {
  need_node; need_deps; need_env
  start_db
  need_engine
  ( cd server && DATABASE_URL="${DATABASE_URL:-$COMPOSE_DB_URL}" npx tsx scripts/set-checkin.ts )
}

scenario_check() {
  need_node; need_deps
  step "Types"
  ( cd server && npx tsc --noEmit )
  ( cd web && npx tsc --noEmit )
  step "Formatting"
  npx prettier --check .
  step "Tests"
  scenario_test
  ok "Everything is clean"
}

scenario_build() {
  need_node; need_deps
  step "Building both workspaces"
  npm run build
  ok "server/dist and server/public are ready"
}

usage() {
  cat <<TEXT
${BOLD}./run <scenario>${OFF}

  ${BOLD}dev${OFF} [--bg]     Postgres, migrations, the server and Vite together
  ${BOLD}start${OFF} [--bg]   the built app on one port, reachable from a phone on this network
  ${BOLD}stop${OFF}           stop whatever ${BOLD}dev --bg${OFF} or ${BOLD}start --bg${OFF} left running
  ${BOLD}test${OFF}           the server and web suites
  ${BOLD}test:ui${OFF}        browser journeys against the whole product
  ${BOLD}check${OFF}          types, formatting, and the server and web suites
  ${BOLD}build${OFF}          compile the server and build the SPA
  ${BOLD}migrate${OFF}        apply migrations to the local database
  ${BOLD}owner:password${OFF} set the owner's password (also signs every device out)
  ${BOLD}house:add${OFF}      create a house: its engine resource, then its row here
  ${BOLD}house:checkin${OFF}  move a house's check-in time, if it has no future bookings

Before the first ${BOLD}start${OFF}: an engine key in .env, then ${BOLD}owner:password${OFF} and ${BOLD}house:add${OFF}.
The booking engine must be running for both: (cd ../booking-engine && ./run dev --bg)
TEXT
}

SCENARIO="${1:-}"
[ $# -gt 0 ] && shift || true

case "$SCENARIO" in
  dev)            scenario_dev "$@" ;;
  start)          scenario_start "$@" ;;
  stop)           scenario_stop ;;
  test)           scenario_test ;;
  test:ui)        scenario_test_ui ;;
  check)          scenario_check ;;
  build)          scenario_build ;;
  migrate)        scenario_migrate ;;
  owner:password) scenario_password ;;
  house:add)      scenario_house_add "$@" ;;
  house:checkin)  scenario_house_checkin ;;
  ''|-h|--help)   usage ;;
  *)              die "Unknown scenario: ${SCENARIO}" "Run ./run with no arguments to see the list." ;;
esac
